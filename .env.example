# ---------------------------------------------------------------------------
# BackPilot environment configuration
# Copy to .env with:  cp .env.example .env
# All values are overridable per-service via docker compose environment.
# ---------------------------------------------------------------------------

# ---- Ports (host-facing) ---------------------------------------------------
# NOTE: 3000/8001 were taken on the dev machine, so BackPilot uses free ports.
FRONTEND_PORT=3001
BACKEND_PORT=8002
LEGACY_PORTAL_PORT=8081
POSTGRES_PORT=5433
REDIS_PORT=6380

# ---- Database --------------------------------------------------------------
POSTGRES_USER=backpilot
POSTGRES_PASSWORD=backpilot
POSTGRES_DB=backpilot
DATABASE_URL=postgresql+psycopg2://backpilot:backpilot@postgres:5432/backpilot

# ---- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- Agent limits ----------------------------------------------------------
MAX_ACTION_RETRIES=3
MAX_RECOVERY_ATTEMPTS=2
AGENT_MAX_STEPS=100
HTTP_TIMEOUT_MS=10000

# ---- Legacy portal (failure injection, default NORMAL) ---------------------
PORTAL_FAILURE_MODE=NORMAL
# Comma separated "" = random disabled. Otherwise deterministic sequence e.g. "UNEXPECTED_MODAL,CAPTCHA"
PORTAL_FAILURE_SEQUENCE=
# Seed for pseudo-random ordering when a sequence is given but a scenario id applies randomness
PORTAL_RANDOM_SEED=42

# HITL: the dashboard is served on this base URL so the human can open the browser / resume
DASHBOARD_BASE_URL=http://localhost:3001
# Allowed URLs the browser executor may navigate to (demo mode). Comma separated.
ALLOWED_DOMAINS=localhost,legacy-portal

# ---- LLM planner -----------------------------------------------------------
# Leave OPENAI_API_KEY empty to use the deterministic MockPlanner (keyless).
OPENAI_API_KEY=
OPENAI_MODEL=Deepseek-V4-Flash
OPENAI_BASE_URL=https://litellm.dev1.smarbl.com/v1

# ---- Upload guardrails -----------------------------------------------------
MAX_UPLOAD_BYTES=5242880
